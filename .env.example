# ============================================================
# Smart Parking Environment Configuration (.env)
# ============================================================

# Option 1: Local Mosquitto Broker (via Docker)
MQTT_BROKER=localhost
MQTT_PORT=1883

# Option 2: Free Public Broker (no local Docker required)
# Uncomment to use public HiveMQ:
# MQTT_BROKER=broker.hivemq.com
# MQTT_PORT=1883

MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=parking-backend-srv

DATABASE_URL=sqlite:///./parking.db
LOT_ID=A
NUM_SLOTS=4
MODEL_PATH=backend/models/occupancy_model.pkl

